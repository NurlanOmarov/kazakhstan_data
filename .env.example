# Скопируйте в .env и заполните. .env в git НЕ коммитится.

# Обязательно: длинный случайный секрет для подписи JWT.
# Сгенерировать:  python -c "import secrets; print(secrets.token_hex(32))"
KZ_JWT_SECRET=

# Безопасность сессии (1 = Secure-cookie, только по HTTPS)
KZ_SECURE_COOKIES=1

# Параметры блокировки и квот (можно не менять)
KZ_TOKEN_TTL_HOURS=8
KZ_MAX_FAILED=5
KZ_LOCK_MINUTES=15
KZ_DAILY_SEARCH=500
KZ_DAILY_EXPORT=20
KZ_EXPORT_MAX_ROWS=5000

# Первичный админ (используется init_users.py при первом запуске)
KZ_ADMIN_USER=admin
KZ_ADMIN_PASSWORD=
